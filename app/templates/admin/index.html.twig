{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
    .table tbody tr td { background-color: #5bc0de !important; }
</style>
{% endblock %}

{% block title %}Espace administration{% endblock %}

{% block body %}
    <h1 class="text-center mt-4">Espace administration</h1>

    <a href="{{ path('app_admin_save') }}" class="text-dark text-decoration-none mb-3 d-block">Ajouter une phrase du jour ➕</a>


    <table class="table mt-2">
        <tbody>
            {% for sentence in sentences %}
            <tr>
                <td>{{ sentence.createdAt|date('d/m/Y') }}</td>
                <td>{{ sentence.content }}</td>
                <td>
                    <span class="badge bg-{{ sentence.category.color }}">
                        {{ sentence.category.name }}
                    </span>
                </td>
                <td><a href="{{ path('app_admin_save', {id: sentence.id}) }}" class="text-decoration-none">✏️</a></td>
                <td><a href="#" class="text-decoration-none">❌</a></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}