{% extends 'base.html.twig' %}

{% block title %}Accueil - Phrase du jour{% endblock %}

{% block stylesheets %}
<style>
    .table tbody tr td { background-color: #e9ecef !important; }
    .table tbody tr td a { text-decoration: none; color: #000; }
</style>
{% endblock %}

{% block body %}
    <h1 class="text-center mt-4">Les phrases du jour</h1>

    <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
        <a href="{{ path('app_home') }}"
            class="badge text-decoration-none {{ currentCategory is null ? 'rounded' : 'rounded-pill' }} bg-secondary">
            toutes les phrases
        </a>
        {% for category in categories %}
            <a href="{{ path('app_home', {category: category.id}) }}"
                class="badge text-decoration-none {{ currentCategory == category.id ? 'rounded' : 'rounded-pill' }} bg-{{ category.color }}">
                {{ category.name }}
            </a>
        {% endfor %}
    </div>

    <table class="table mt-4">
        <tbody>
            {% for sentence in sentences %}
            <tr>
                <td>
                    <a href="{{ path('app_sentence_show', {id: sentence.id}) }}">
                        la phrase du {{ sentence.createdAt|date('d/m/Y') }} 👁️
                    </a>
                </td>
                <td>
                    <span class="badge rounded-pill bg-{{ sentence.category.color }}">
                        {{ sentence.category.name }}
                    </span>
                </td>
                <td>👍 {{ sentence.likes }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}