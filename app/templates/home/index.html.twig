{% extends 'base.html.twig' %}

{% block title %}Accueil - Phrase du jour{% endblock %}

{% block body %}
    <h1 class="text-center mt-4">Les phrases du jour</h1>

    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Date</th>
                <th>Catégorie</th>
                <th>Likes</th>
            </tr>
        </thead>
        <tbody>
            {% for sentence in sentences %}
            <tr>
                <td>
                    <a href="#">
                        {{ sentence.createdAt|date('d/m/Y') }}
                    </a>
                </td>
                <td>
                    <span class="badge bg-{{ sentence.category.color }}">
                        {{ sentence.category.name }}
                    </span>
                </td>
                <td>👍 {{ sentence.likes }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}