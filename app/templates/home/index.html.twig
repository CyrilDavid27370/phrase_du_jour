{% extends 'base.html.twig' %}

{% block title %}Accueil - Phrase du jour{% endblock %}

{% block stylesheets %}
<style>
    .table tbody tr td { background-color: #e9ecef !important; }
    .table tbody tr td a { text-decoration: none; color: #000; }
</style>
{% endblock %}

{% block body %}
    <h1 class="text-center mt-4">Les phrases du jour</h1>

    <table class="table mt-4">
        <tbody>
            {% for sentence in sentences %}
            <tr>
                <td>
                    <a href="{{ path('app_sentence_show', {id: sentence.id}) }}">
                        la phrase du {{ sentence.createdAt|date('d/m/Y') }} 👁️
                    </a>
                </td>
                <td>
                    <span class="badge bg-{{ sentence.category.color }}">
                        {{ sentence.category.name }}
                    </span>
                </td>
                <td>👍 {{ sentence.likes }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}