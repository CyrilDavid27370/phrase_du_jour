{% extends 'base.html.twig' %}

{% block title %}La phrase du jour{% endblock %}

{% block body %}
    <h1 class="text-center mt-4">La phrase du jour</h1>

    <div class="card mt-4 border-{{ sentence.category.color }}">
        <div class="card-body bg-{{ sentence.category.color }}">
            <span class="badge bg-{{ sentence.category.color }} float-end">
                {{ sentence.category.name }}
            </span>
            <h5 class="card-title">{{ sentence.createdAt|date('d/m/Y') }}</h5>
            <p class="card-text">{{ sentence.content }}</p>
            <a href="{{ path('app_sentence_like', {id: sentence.id}) }}" class="text-decoration-none">
                {{ isLiked ? '👍' : '👍🏻' }} {{ sentence.likes }}
            </a>
        </div>
    </div>

    <h3 class="mt-5">Commentaires</h3>

    {% if app.user %}
        {{ form_start(commentForm) }}
            {{ form_widget(commentForm.content) }}
            <button type="submit" class="btn btn-primary mt-2">Commenter</button>
        {{ form_end(commentForm) }}
    {% endif %}

    {% if comments is empty %}
        <p class="text-muted mt-3">Soyez le premier à commenter !</p>
    {% else %}
        {% for comment in comments %}
    <div class="mt-3">
        <strong>{{ comment.author.username }}</strong>
        (le {{ comment.createdAt|date('d/m/Y à H:i:s') }}) :
        {{ comment.content }}

        {% if app.user and app.user == comment.author %}
            <a href="{{ path('app_comment_update', {id: comment.id}) }}" class="text-decoration-none ms-2">✏️</a>
            <form method="post" action="{{ path('app_comment_delete', {id: comment.id}) }}" class="d-inline ms-1">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ comment.id) }}">
                <button type="submit" style="background:none;border:none;cursor:pointer;">❌</button>
            </form>
        {% endif %}

        {% if app.user and app.user != comment.author and not comment.isReported %}
            <a href="{{ path('app_comment_report', {id: comment.id}) }}"
            class="text-decoration-none ms-2"
            title="Signaler ce commentaire">
                🚩
            </a>
        {% endif %}
    </div>
{% endfor %}
    {% endif %}
{% endblock %}